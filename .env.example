# Copy this file to .env and fill in your values.
# Deploying through Portainer? Portainer ignores .env — set the same variables
# under Stacks -> Environment variables instead.
#
# NOTE: the guide (guide.html) uses 192.0.2.x, the RFC 5737 documentation
# range, as a stand-in for a real LAN IP.

# ---------------------------------------------------------------
# Required: secrets
# ---------------------------------------------------------------
# WireGuard (NordLynx) private key — get it with ./get-nordlynx-key.sh
WIREGUARD_PRIVATE_KEY=
# Long random string for Mixarr sessions: openssl rand -hex 32
SESSION_SECRET=
# Lidarr -> Settings -> General -> API Key
LIDARR_API_KEY=

# ---------------------------------------------------------------
# Required: host details
# ---------------------------------------------------------------
# LAN IP of the machine running the stack
SERVER_IP=192.0.2.10
# Your LAN subnet — gluetun's firewall must allow replies back to it
LAN_SUBNET=192.0.2.0/24
# Single parent mount holding torrents/ and media/ (keeps hardlinks working)
DATA_DIR=/mnt/disk/data

# ---------------------------------------------------------------
# Optional (these defaults are used if unset)
# ---------------------------------------------------------------
# Fixed subnet for the internal docker network; gluetun's firewall rule
# depends on it staying put
DOCKER_SUBNET=172.30.0.0/24
# Where the config databases live (SSD, ext4 — never the NTFS data disk)
APPDATA_DIR=/opt/appdata
PUID=1000
PGID=1000
TZ=Etc/UTC
# VPN exit country for gluetun
VPN_SERVER_COUNTRIES=Mexico
